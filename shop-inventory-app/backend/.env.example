# Copy this file to .env (or export these as real shell/OS environment
# variables, or set them in your IDE run config / deployment platform).
# .env itself is gitignored - never commit real credentials.

# Supabase -> Project Settings -> Database -> Connection string (URI / JDBC)
# Use the "Session pooler" or direct connection string, JDBC form, e.g.:
# jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres

SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-supabase-db-password>

# Must match the origin your Vite dev server actually runs on.
CORS_ALLOWED_ORIGIN=http://localhost:5173

SERVER_PORT=8080
